{
  "name": "ui-annotator",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Chrome extension for marking up UI issues and exporting them as an HTML report.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "lint": "oxlint --deny-warnings",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@floating-ui/dom": "^1.8.0",
    "@medv/finder": "^4.0.2",
    "@tanstack/react-query": "^5.105.0",
    "@webext-core/messaging": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  }
}
