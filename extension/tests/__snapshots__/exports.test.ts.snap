        <td style="border: 1px solid #c9cedb; padding: 5px 7px; font-family: Arial, sans-serif; font-size: 9pt; color: #12151c; vertical-align: top; width: 316px;"><a href="https://team.atlassian.net/browse/SS-113">SS-113</a></td>
